# Run dependency install scripts one at a time. On linux-arm64 the npm
# prebuilds of tree-sitter-typescript 0.23.2 and its nested
# tree-sitter-javascript 0.23.1 are x86-64 (#3599), so source-checkout installs
# compile both. Their node-gyp configures write node-addon-api's makefile to
# the same tree-sitter-typescript/node-addon-api/ directory with different
# relative stamp paths; interleaved, the TypeScript build fails with
# "No rule to make target .../node_addon_api_except.stamp". Serial scripts
# cannot interleave. npm never packs .npmrc, so published installs are unaffected.
foreground-scripts=true
